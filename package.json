{
  "name": "ugonote2",
  "version": "1.0.0",
  "description": "ブラウザで動くパラパラまんがエディタ（うごくノート2）",
  "type": "module",
  "scripts": {
    "preinstall": "node scripts/prepare.mjs --ci",
    "prebuild": "node scripts/prepare.mjs",
    "build": "node build.mjs",
    "prebuild:min": "node scripts/prepare.mjs",
    "build:min": "node build.mjs --min",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run typecheck && npm run build:min",
    "build:single": "npm run build:min && node build_single.mjs",
    "build:site": "npm run build:min && node build_hosted.mjs",
    "reset": "node scripts/reset.mjs"
  },
  "license": "CC0-1.0",
  "dependencies": {
    "fflate": "0.8.2",
    "mediabunny": "^1.50.6",
    "perfect-freehand": "^1.2.3"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "typescript": "^6.0.3"
  }
}
